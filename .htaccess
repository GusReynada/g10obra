# Configuración para Hostinger Apache
Options -Indexes
ServerSignature Off

# Codificación de caracteres predeterminada
AddDefaultCharset UTF-8

# Seguridad: Proteger archivos sensibles, credenciales y módulos internos
<FilesMatch "^(schema\.sql|\.env|composer\.json|composer\.lock|.*\.local\.php|crypto\.php|auth\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
