# Configuración para Hostinger Apache
Options -Indexes
ServerSignature Off

# Codificación de caracteres predeterminada
AddDefaultCharset UTF-8

# Seguridad básica: Proteger archivos de configuración y base de datos
<FilesMatch "^(schema\.sql|\.env|composer\.json|composer\.lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Habilitar compresión Gzip para mayor velocidad
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>
